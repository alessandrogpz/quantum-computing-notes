# Template for .env -- copy this file to .env and fill it in.
#
#     cp .env.example .env
#
# .env is gitignored and never leaves this machine.
# NEVER put a real token in this file: .env.example IS committed.

# API token from https://quantum.cloud.ibm.com/  (Account -> API token)
QISKIT_API_KEY=

# CRN of the instance to use. Optional; blank uses your account default.
INSTANCE=

# Optional. Defaults to ibm_quantum_platform.
CHANNEL=
